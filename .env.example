DATABASE_URL=postgresql+asyncpg://kira:kira@db:5432/kira
JWT_SECRET=development-only-replace-with-a-secure-jwt-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173

# ── Butler ────────────────────────────────────────────────────────────────────
# Without a key the Butler runs its offline model: the graph, the tools, the
# approvals and the evidence are identical, but the prose is scripted and it
# only recognises the phrasings it has patterns for. With a key it converses.
#
# Get one from Alibaba Cloud Model Studio (the international console):
#   https://bailian.console.alibabacloud.com/  →  API-KEY
DASHSCOPE_API_KEY=
# The international endpoint. Use dashscope.aliyuncs.com (no -intl) on a
# mainland-China account.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# The check script lists what your account can actually call:
#   cd apps/api && .venv/bin/python ../../scripts/check-butler-model.py
BUTLER_MODEL=qwen3.6-plus
# Set to 1 to force the offline model even when a key is present — useful for
# demoing on a venue network you do not trust.
BUTLER_OFFLINE=0
BUTLER_REQUEST_TIMEOUT_SECONDS=30

# A separate worker writes one idempotent briefing per day at this KL-local time.
WORKER_TIMEZONE=Asia/Kuala_Lumpur
WORKER_HOUR=5
WORKER_MINUTE=0

# Pins "today" so the seeded demo produces the same numbers on any date.
# docker compose sets this already; uncomment for a local uvicorn run.
# DEMO_TODAY=2026-09-03
